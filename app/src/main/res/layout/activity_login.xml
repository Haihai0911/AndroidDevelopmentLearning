<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/page_padding"
    android:background="@color/bg_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_card"
        android:elevation="@dimen/card_elevation">

        <!-- 标题栏 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/teal_primary"
            android:padding="@dimen/title_padding"
            android:text="@string/login_title"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <!-- 登录方式切换 -->
            <RadioGroup
                android:id="@+id/rg_login_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/margin_bottom_medium">

                <RadioButton
                    android:id="@+id/rb_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_type_password"
                    android:checked="true"
                    android:buttonTint="@color/red_accent"
                    android:layout_marginEnd="@dimen/margin_end_radio"/>

                <RadioButton
                    android:id="@+id/rb_verification"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_type_verification"
                    android:buttonTint="@color/red_accent" />
            </RadioGroup>

            <!-- 手机号输入 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/margin_bottom_small">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_phone"
                    android:textSize="@dimen/text_size_label"
                    android:textColor="@color/text_dark"/>

                <EditText
                    android:id="@+id/et_phone"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/input_height"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edittext"
                    android:hint="@string/hint_phone"
                    android:paddingHorizontal="@dimen/input_padding_horizontal"
                    android:textSize="@dimen/text_size_input"
                    android:inputType="phone"/>
            </LinearLayout>

            <!-- 动态切换区域：密码/验证码 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/margin_bottom_small">

                <!-- 标签文字，动态修改 -->
                <TextView
                    android:id="@+id/tv_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_password"
                    android:textSize="@dimen/text_size_label"
                    android:textColor="@color/text_dark"/>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="@dimen/input_height"
                    android:layout_weight="1">

                    <!-- 输入框，动态修改 hint 和 inputType -->
                    <EditText
                        android:id="@+id/et_input"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_edittext"
                        android:hint="@string/hint_password"
                        android:paddingHorizontal="@dimen/input_padding_horizontal"
                        android:textSize="@dimen/text_size_input"
                        android:inputType="textPassword"/>

                    <!-- 忘记密码按钮 -->
                    <TextView
                        android:id="@+id/tv_forget_pwd"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:background="@color/btn_gray_bg"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/input_padding_horizontal"
                        android:text="@string/btn_forget_pwd"
                        android:textColor="@color/text_dark"
                        android:textSize="@dimen/text_size_input"/>

                    <!-- 获取验证码按钮 (默认隐藏) -->
                    <TextView
                        android:id="@+id/tv_get_code"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:background="@color/btn_gray_bg"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/input_padding_horizontal"
                        android:text="@string/btn_get_code"
                        android:textColor="@color/text_dark"
                        android:textSize="@dimen/text_size_input"
                        android:visibility="gone"/>
                </FrameLayout>
            </LinearLayout>

            <!-- 记住密码 (在验证码模式下会隐藏) -->
            <CheckBox
                android:id="@+id/cb_remember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cb_remember"
                android:textSize="@dimen/text_size_input"
                android:layout_marginBottom="@dimen/margin_bottom_medium"/>

            <!-- 登录按钮 -->
            <Button
                android:id="@+id/btn_login"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:backgroundTint="@color/btn_login_bg"
                android:text="@string/btn_login"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_button"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>